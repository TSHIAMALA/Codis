# Valeurs par défaut versionnées. NE METTEZ AUCUN SECRET ICI :
# les vraies valeurs vont dans .env.local (non versionné) sur chaque poste / serveur.
#   APP_SECRET      : php -r "echo bin2hex(random_bytes(16));"
#   JWT_PASSPHRASE  : php -r "echo bin2hex(random_bytes(32));"  puis régénérer config/jwt/*.pem

APP_ENV=dev
APP_SECRET=
DEFAULT_URI=http://localhost
DATABASE_URL="mysql://root:@127.0.0.1:3306/db_codis?serverVersion=8.2.0&charset=utf8mb4"
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
MAILER_DSN=null://null
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
