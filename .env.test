# Environnement de test (.env.local n'est pas chargé en test).
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
# Nom de base suffixé automatiquement par "_test" (config/packages/doctrine.yaml) : db_codis_test
DATABASE_URL="mysql://root:@127.0.0.1:3306/db_codis?serverVersion=8.2.0&charset=utf8mb4"

# Clés JWT dédiées aux tests, non chiffrées et sans valeur hors des tests (config/jwt/test/).
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/test/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/test/public.pem
JWT_PASSPHRASE=
