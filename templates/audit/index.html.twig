{% extends 'base/base.html.twig' %}

{% block page_title %}Audit & Traçabilité Complète{% endblock %}
{% block page_subtitle %}Historique de toutes les opérations sensibles et intégrité des données{% endblock %}

{% block body %}
<div class="card-table">
    <div class="card-table-header">
        <div class="card-table-title"><i class="fa-solid fa-shield-halved"></i> Journal d'Audit Système</div>
        <span class="badge badge-gold">{{ logs.total }} entrées</span>
    </div>

    <form method="get" class="filtres">
        <select name="table" class="form-select" onchange="this.form.submit()" aria-label="Filtrer par table">
            <option value="">Toutes les tables</option>
            {% for t in tables %}
                <option value="{{ t }}" {% if app.request.query.get('table') == t %}selected{% endif %}>{{ t }}</option>
            {% endfor %}
        </select>
        {% if app.request.query.get('table') %}
            <a href="{{ path('app_audit_index') }}" class="filtres-reset"><i class="fa-solid fa-xmark"></i> Réinitialiser</a>
        {% endif %}
    </form>

<table class="custom-table">
        <thead>
            <tr>
                <th>Horodatage</th>
                <th>Utilisateur</th>
                <th>Table / Entité</th>
                <th>Action</th>
                <th>ID Réf</th>
                <th>Adresse IP</th>
            </tr>
        </thead>
        <tbody>
            {% for log in logs %}
            <tr>
                <td>{{ log.createdAt ? log.createdAt|date('d/m/Y H:i:s') : '-' }}</td>
                <td class="font-bold">{{ log.utilisateur ? log.utilisateur.username : 'System' }}</td>
                <td><span class="badge badge-gold">{{ log.tableName }}</span></td>
                <td><span class="badge badge-info">{{ log.action }}</span></td>
                <td>#{{ log.referenceId }}</td>
                <td style="color: var(--text-muted);">{{ log.adresseIp }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {{ include('_pagination.html.twig', {page: logs}) }}
</div>
{% endblock %}