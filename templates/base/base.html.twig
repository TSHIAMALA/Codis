<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>
			{% block title %}CODIS - Colonne Distribution System
			{% endblock %}
		</title>
		<!-- Favicon -->
		<link rel="icon" type="image/png" href="{{ asset('images/icon.png') }}">
		<link rel="shortcut icon" type="image/png" href="{{ asset('images/icon.png') }}">
		<link
		rel="apple-touch-icon" href="{{ asset('images/icon.png') }}">
		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link
		href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">
		<!-- FontAwesome & Tabler Icons -->
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

		<style>:root
		{
			/* Brand Colors — from CODIS icon */
			--primary: #b91c1c;
			--primary-light: #dc2626;
			--primary-dark: #7f1d1d;
			--primary-glow: rgba(220, 38, 38, 0.35);

			--gold: #d4a017;
			--gold-light: #f0c040;
			--gold-dark: #a87c12;
			--gold-glow: rgba(212, 160, 23, 0.3);

			/* Backgrounds */
			--bg-body: #0d0d14;
			--bg-sidebar: #111118;
			--bg-card: rgba(25, 25, 38, 0.75);
			--bg-card-hover: rgba(35, 35, 52, 0.85);
			--border-card: rgba(212, 160, 23, 0.12);
			--border-subtle: rgba(255, 255, 255, 0.06);

			/* Typography */
			--text-main: #f1f1f4;
			--text-muted: #8b8ba3;
			--text-gold: #f0c040;

			/* Status */
			--success: #10b981;
			--warning: #f59e0b;
			--danger: #ef4444;
			--info: #38bdf8;

			/* Layout */
			--sidebar-width: 280px;
		}

		* {
			box-sizing: border-box;
			margin: 0;
			padding: 0;
		}

		body {
			font-family: 'Inter', sans-serif;
			background-color: var(--bg-body);
			color: var(--text-main);
			min-height: 100vh;
			display: flex;
			background-image: radial-gradient(ellipse at 0% 0%, rgba(185, 28, 28, 0.08) 0px, transparent 55%), radial-gradient(ellipse at 100% 100%, rgba(212, 160, 23, 0.06) 0px, transparent 55%), radial-gradient(ellipse at 50% 50%, rgba(25, 25, 50, 0.5) 0px, transparent 80%);
			background-attachment: fixed;
		}

		/* ========== SCROLLBAR ========== */
		::-webkit-scrollbar {
			width: 6px;
		}
		::-webkit-scrollbar-track {
			background: transparent;
		}
		::-webkit-scrollbar-thumb {
			background: rgba(212, 160, 23, 0.25);
			border-radius: 10px;
		}
		::-webkit-scrollbar-thumb:hover {
			background: rgba(212, 160, 23, 0.45);
		}

		/* ========== SIDEBAR ========== */
		aside.sidebar {
			width: var(--sidebar-width);
			background: var(--bg-sidebar);
			border-right: 1px solid var(--border-card);
			display: flex;
			flex-direction: column;
			position: fixed;
			top: 0;
			bottom: 0;
			left: 0;
			z-index: 100;
			overflow: hidden;
		}

		/* Gold accent line at top of sidebar */
		aside.sidebar::before {
			content: '';
			position: absolute;
			top: 0;
			left: 0;
			right: 0;
			height: 2px;
			background: linear-gradient(90deg, var(--primary), var(--gold), var(--primary));
		}

		.brand-header {
			padding: 24px 20px;
			display: flex;
			align-items: center;
			gap: 14px;
			border-bottom: 1px solid var(--border-card);
			position: relative;
		}

		.brand-logo {
			width: 48px;
			height: 48px;
			border-radius: 14px;
			background: rgba(255, 255, 255, 0.04);
			border: 1px solid rgba(212, 160, 23, 0.2);
			display: flex;
			align-items: center;
			justify-content: center;
			overflow: hidden;
			padding: 3px;
			box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4), 0 0 15px rgba(212, 160, 23, 0.08);
			flex-shrink: 0;
		}

		.brand-logo img {
			width: 100%;
			height: 100%;
			object-fit: contain;
			border-radius: 10px;
		}

		.brand-title {
			font-family: 'Plus Jakarta Sans', sans-serif;
			font-size: 22px;
			font-weight: 800;
			letter-spacing: -0.5px;
			background: linear-gradient(135deg, #ffffff 0%, var(--gold-light) 60%, var(--gold) 100%);
			-webkit-background-clip: text;
			-webkit-text-fill-color: transparent;
		}

		.brand-sub {
			font-size: 10px;
			color: var(--text-muted);
			text-transform: uppercase;
			letter-spacing: 2px;
			font-weight: 500;
		}

		/* Navigation */
		.nav-section-label {
			padding: 16px 20px 8px;
			font-size: 10px;
			font-weight: 700;
			color: var(--text-muted);
			text-transform: uppercase;
			letter-spacing: 1.5px;
		}

		.nav-links {
			list-style: none;
			padding: 12px;
			flex: 1;
			overflow-y: auto;
			display: flex;
			flex-direction: column;
			gap: 4px;
		}

		.nav-item a {
			display: flex;
			align-items: center;
			gap: 12px;
			padding: 11px 16px;
			color: var(--text-muted);
			text-decoration: none;
			font-weight: 500;
			font-size: 13.5px;
			border-radius: 10px;
			transition: all 0.25s ease;
			position: relative;
		}

		.nav-item a:hover {
			color: var(--text-main);
			background: rgba(220, 38, 38, 0.08);
		}

		.nav-item.active a {
			color: #ffffff;
			background: linear-gradient(135deg, rgba(185, 28, 28, 0.25), rgba(212, 160, 23, 0.12));
			border: 1px solid rgba(220, 38, 38, 0.2);
			box-shadow: 0 2px 12px rgba(185, 28, 28, 0.15);
		}

		.nav-item.active a::before {
			content: '';
			position: absolute;
			left: 0;
			top: 50%;
			transform: translateY(-50%);
			width: 3px;
			height: 60%;
			background: linear-gradient(to bottom, var(--primary-light), var(--gold));
			border-radius: 0 4px 4px 0;
		}

		.nav-item a i {
			font-size: 15px;
			width: 22px;
			text-align: center;
			transition: color 0.25s ease;
		}

		.nav-item a:hover i {
			color: var(--primary-light);
		}

		.nav-item.active a i {
			color: var(--gold-light);
		}

		/* Submenu Navigation */
		.nav-item.has-submenu {
			display: flex;
			flex-direction: column;
		}

		.nav-item-header {
			display: flex;
			align-items: center;
			justify-content: space-between;
			padding: 11px 16px;
			color: var(--text-muted);
			font-weight: 500;
			font-size: 13.5px;
			border-radius: 10px;
			cursor: pointer;
			transition: all 0.25s ease;
			user-select: none;
		}

		.nav-item-header:hover,
		.nav-item.open .nav-item-header {
			color: var(--text-main);
			background: rgba(220, 38, 38, 0.08);
		}

		.nav-item-header .header-left {
			display: flex;
			align-items: center;
			gap: 12px;
		}

		.nav-item-header i.icon-main {
			font-size: 15px;
			width: 22px;
			text-align: center;
			transition: color 0.25s ease;
		}

		.nav-item.open .nav-item-header i.icon-main {
			color: var(--gold-light);
		}

		.nav-item-header .chevron {
			font-size: 11px;
			transition: transform 0.25s ease;
		}

		.nav-item.open .nav-item-header .chevron {
			transform: rotate(180deg);
			color: var(--gold-light);
		}

		.submenu {
			list-style: none;
			padding: 4px 0 6px 28px;
			display: none;
			flex-direction: column;
			gap: 2px;
		}

		.nav-item.open .submenu {
			display: flex;
		}

		.submenu-item a {
			display: flex;
			align-items: center;
			gap: 10px;
			padding: 8px 12px;
			color: var(--text-muted);
			text-decoration: none;
			font-size: 12.5px;
			font-weight: 500;
			border-radius: 8px;
			transition: all 0.2s ease;
		}

		.submenu-item a:hover,
		.submenu-item.active a {
			color: var(--gold-light);
			background: rgba(212, 160, 23, 0.08);
			border-left: 2px solid var(--gold);
		}

		.submenu-item a i {
			font-size: 12px;
			width: 16px;
			text-align: center;
		}

		/* Sidebar footer */
		.sidebar-footer {
			padding: 16px 20px;
			border-top: 1px solid var(--border-card);
			font-size: 11px;
			color: var(--text-muted);
			text-align: center;
		}

		.sidebar-footer .version {
			display: inline-flex;
			align-items: center;
			gap: 6px;
			padding: 4px 10px;
			border-radius: 20px;
			background: rgba(212, 160, 23, 0.08);
			border: 1px solid rgba(212, 160, 23, 0.15);
			color: var(--gold-light);
			font-weight: 600;
			font-size: 10px;
		}

		/* ========== MAIN CONTENT ========== */
		main.main-content {
			margin-left: var(--sidebar-width);
			flex: 1;
			padding: 32px 40px;
			max-width: calc(100vw - var(--sidebar-width));
			min-height: 100vh;
		}

		/* ========== TOPBAR ========== */
		.topbar {
			display: flex;
			justify-content: space-between;
			align-items: center;
			margin-bottom: 36px;
			padding-bottom: 24px;
			border-bottom: 1px solid var(--border-subtle);
		}

		.page-title {
			font-family: 'Plus Jakarta Sans', sans-serif;
			font-size: 28px;
			font-weight: 800;
			letter-spacing: -0.5px;
			color: #ffffff;
		}

		.page-subtitle {
			font-size: 14px;
			color: var(--text-muted);
			margin-top: 4px;
		}

		.user-badge {
			display: flex;
			align-items: center;
			gap: 12px;
			padding: 10px 20px;
			background: var(--bg-card);
			border: 1px solid var(--border-card);
			border-radius: 9999px;
			backdrop-filter: blur(12px);
			transition: all 0.2s ease;
		}

		.user-badge:hover {
			border-color: rgba(212, 160, 23, 0.3);
			box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
		}

		/* ========== STATS GRID ========== */
		.grid-stats {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
			gap: 20px;
			margin-bottom: 36px;
		}

		.card-stat {
			background: var(--bg-card);
			border: 1px solid var(--border-card);
			padding: 24px;
			border-radius: 16px;
			backdrop-filter: blur(12px);
			position: relative;
			overflow: hidden;
			transition: all 0.3s ease;
		}

		.card-stat::after {
			content: '';
			position: absolute;
			top: 0;
			left: 0;
			right: 0;
			height: 2px;
			background: linear-gradient(90deg, var(--primary), var(--gold));
			opacity: 0;
			transition: opacity 0.3s ease;
		}

		.card-stat:hover {
			transform: translateY(-3px);
			box-shadow: 0 12px 32px -8px rgba(0, 0, 0, 0.5), 0 0 20px rgba(185, 28, 28, 0.08);
			border-color: rgba(212, 160, 23, 0.2);
		}

		.card-stat:hover::after {
			opacity: 1;
		}

		.card-stat .stat-label {
			font-size: 12px;
			font-weight: 600;
			color: var(--text-muted);
			text-transform: uppercase;
			letter-spacing: 0.8px;
		}

		.card-stat .stat-value {
			font-size: 30px;
			font-weight: 800;
			font-family: 'Plus Jakarta Sans', sans-serif;
			margin: 10px 0 8px;
			background: linear-gradient(135deg, #ffffff, var(--gold-light));
			-webkit-background-clip: text;
			-webkit-text-fill-color: transparent;
		}

		.card-stat .stat-icon {
			position: absolute;
			top: 20px;
			right: 20px;
			font-size: 28px;
			background: linear-gradient(135deg, rgba(185, 28, 28, 0.2), rgba(212, 160, 23, 0.15));
			-webkit-background-clip: text;
			-webkit-text-fill-color: transparent;
		}

		/* ========== TABLES & CONTENT CARDS ========== */
		.card-table {
			background: var(--bg-card);
			border: 1px solid var(--border-card);
			border-radius: 16px;
			backdrop-filter: blur(12px);
			padding: 0;
			margin-bottom: 32px;
			overflow: hidden;
		}

		.card-table-header {
			display: flex;
			justify-content: space-between;
			align-items: center;
			padding: 20px 24px;
			border-bottom: 1px solid var(--border-subtle);
			background: rgba(20, 20, 32, 0.5);
		}

		.card-table-title {
			font-size: 16px;
			font-weight: 700;
			font-family: 'Plus Jakarta Sans', sans-serif;
			display: flex;
			align-items: center;
			gap: 10px;
		}

		.card-table-title i {
			color: var(--gold);
			font-size: 16px;
		}

		.card-table-body {
			padding: 24px;
		}

		table.custom-table {
			width: 100%;
			border-collapse: collapse;
			font-size: 13.5px;
		}

		table.custom-table th {
			text-align: left;
			padding: 14px 20px;
			color: var(--text-muted);
			font-weight: 600;
			border-bottom: 1px solid var(--border-subtle);
			font-size: 11px;
			text-transform: uppercase;
			letter-spacing: 0.8px;
			background: rgba(15, 15, 25, 0.3);
		}

		table.custom-table td {
			padding: 16px 20px;
			border-bottom: 1px solid rgba(255, 255, 255, 0.03);
			color: var(--text-main);
		}

		table.custom-table tr {
			transition: background 0.2s ease;
		}

		table.custom-table tbody tr:hover td {
			background: rgba(212, 160, 23, 0.03);
		}

		table.custom-table tbody tr:last-child td {
			border-bottom: none;
		}

		/* ========== BADGES ========== */
		.badge {
			display: inline-flex;
			align-items: center;
			gap: 6px;
			padding: 5px 12px;
			border-radius: 9999px;
			font-size: 11px;
			font-weight: 600;
			letter-spacing: 0.3px;
		}

		.badge-success {
			background: rgba(16, 185, 129, 0.12);
			color: #34d399;
			border: 1px solid rgba(16, 185, 129, 0.2);
		}
		.badge-warning {
			background: rgba(245, 158, 11, 0.12);
			color: #fbbf24;
			border: 1px solid rgba(245, 158, 11, 0.2);
		}
		.badge-info {
			background: rgba(56, 189, 248, 0.12);
			color: #7dd3fc;
			border: 1px solid rgba(56, 189, 248, 0.2);
		}
		.badge-primary {
			background: rgba(185, 28, 28, 0.12);
			color: #fca5a5;
			border: 1px solid rgba(185, 28, 28, 0.2);
		}
		.badge-danger {
			background: rgba(239, 68, 68, 0.12);
			color: #f87171;
			border: 1px solid rgba(239, 68, 68, 0.2);
		}
		.badge-gold {
			background: rgba(212, 160, 23, 0.12);
			color: var(--gold-light);
			border: 1px solid rgba(212, 160, 23, 0.2);
		}

		/* ========== BUTTONS ========== */
		.btn {
			display: inline-flex;
			align-items: center;
			gap: 8px;
			padding: 10px 20px;
			border-radius: 10px;
			font-size: 13px;
			font-weight: 600;
			text-decoration: none;
			cursor: pointer;
			border: none;
			transition: all 0.25s ease;
			letter-spacing: 0.3px;
		}

		.btn-primary {
			background: linear-gradient(135deg, var(--primary), var(--primary-dark));
			color: #fff;
			box-shadow: 0 4px 16px rgba(185, 28, 28, 0.3);
			border: 1px solid rgba(220, 38, 38, 0.3);
		}
		.btn-primary:hover {
			box-shadow: 0 6px 24px rgba(185, 28, 28, 0.45);
			transform: translateY(-1px);
			background: linear-gradient(135deg, var(--primary-light), var(--primary));
		}

		.btn-gold {
			background: linear-gradient(135deg, var(--gold), var(--gold-dark));
			color: #1a1a1a;
			box-shadow: 0 4px 16px rgba(212, 160, 23, 0.3);
			border: 1px solid rgba(240, 192, 64, 0.3);
		}
		.btn-gold:hover {
			box-shadow: 0 6px 24px rgba(212, 160, 23, 0.45);
			transform: translateY(-1px);
		}

		.btn-outline {
			background: transparent;
			color: var(--text-muted);
			border: 1px solid var(--border-card);
		}
		.btn-outline:hover {
			color: var(--text-main);
			border-color: rgba(212, 160, 23, 0.3);
			background: rgba(212, 160, 23, 0.06);
		}

		.btn-sm {
			padding: 6px 14px;
			font-size: 12px;
			border-radius: 8px;
		}

		/* ========== ALERTS ========== */
		.alert {
			padding: 14px 20px;
			border-radius: 12px;
			margin-bottom: 24px;
			font-size: 14px;
			display: flex;
			align-items: center;
			gap: 12px;
			backdrop-filter: blur(8px);
		}
		.alert-success {
			background: rgba(16, 185, 129, 0.1);
			border: 1px solid rgba(16, 185, 129, 0.25);
			color: #6ee7b7;
		}
		.alert-info {
			background: rgba(56, 189, 248, 0.1);
			border: 1px solid rgba(56, 189, 248, 0.25);
			color: #7dd3fc;
		}

		/* ========== UTILITY CLASSES ========== */
		.text-gold {
			color: var(--gold-light) !important;
		}
		.text-red {
			color: var(--primary-light) !important;
		}
		.text-success {
			color: #34d399 !important;
		}
		.text-warning {
			color: #fbbf24 !important;
		}
		.text-info {
			color: #7dd3fc !important;
		}
		.font-bold {
			font-weight: 700 !important;
		}
		.font-extra {
			font-weight: 800 !important;
		}

		/* ========== DETAIL GRID (for show pages) ========== */
		.detail-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
			gap: 20px;
			padding: 24px;
		}

		.detail-item {
			display: flex;
			flex-direction: column;
			gap: 4px;
		}

		.detail-label {
			font-size: 11px;
			font-weight: 600;
			color: var(--text-muted);
			text-transform: uppercase;
			letter-spacing: 0.8px;
		}

		.detail-value {
			font-size: 16px;
			font-weight: 700;
			color: var(--text-main);
		}

		.detail-value.highlight {
			font-size: 20px;
			font-weight: 800;
			background: linear-gradient(135deg, var(--gold-light), var(--gold));
			-webkit-background-clip: text;
			-webkit-text-fill-color: transparent;
		}

		/* ========== ANIMATIONS ========== */
		@keyframes fadeInUp {
			from {
				opacity: 0;
				transform: translateY(16px);
			}
			to {
				opacity: 1;
				transform: translateY(0);
			}
		}

		.card-stat,
		.card-table {
			animation: fadeInUp 0.5s ease forwards;
		}

		.card-stat:nth-child(2) {
			animation-delay: 0.05s;
		}
		.card-stat:nth-child(3) {
			animation-delay: 0.1s;
		}
		.card-stat:nth-child(4) {
			animation-delay: 0.15s;
		}

		/* ========== RESPONSIVE ========== */
		@media(max-width: 1024px) {
			aside.sidebar {
				width: 72px;
			}
			aside.sidebar .brand-title,
			aside.sidebar .brand-sub,
			aside.sidebar .nav-item a span,
			aside.sidebar .sidebar-footer,
			aside.sidebar .nav-section-label {
				display: none;
			}
			aside.sidebar .nav-item a {
				justify-content: center;
				padding: 14px;
			}
			aside.sidebar .nav-item a i {
				margin: 0;
				font-size: 18px;
			}
			aside.sidebar .brand-header {
				justify-content: center;
				padding: 16px;
			}
			main.main-content {
				margin-left: 72px;
				max-width: calc(100vw - 72px);
				padding: 24px 20px;
			}
		}

		/* ========== MODAL & FORMS ========== */
		.modal-backdrop {
			position: fixed;
			top: 0;
			left: 0;
			right: 0;
			bottom: 0;
			width: 100vw;
			height: 100vh;
			background: rgba(0, 0, 0, 0.8);
			backdrop-filter: blur(10px);
			-webkit-backdrop-filter: blur(10px);
			z-index: 99999;
			display: flex;
			align-items: center;
			justify-content: center;
			opacity: 0;
			pointer-events: none;
			transition: opacity 0.25s ease;
		}

		.modal-backdrop.active {
			opacity: 1;
			pointer-events: auto;
		}

		.modal-content {
			background: #14141e;
			border: 1px solid var(--border-card);
			border-radius: 18px;
			width: 90%;
			max-width: 600px;
			max-height: 90vh;
			overflow-y: auto;
			box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6), 0 0 30px rgba(212, 160, 23, 0.1);
			transform: scale(0.95);
			transition: transform 0.25s ease;
		}

		.modal-backdrop.active .modal-content {
			transform: scale(1);
		}

		.modal-header {
			padding: 20px 24px;
			border-bottom: 1px solid var(--border-subtle);
			display: flex;
			justify-content: space-between;
			align-items: center;
			background: rgba(255, 255, 255, 0.02);
		}

		.modal-title {
			font-family: 'Plus Jakarta Sans', sans-serif;
			font-size: 18px;
			font-weight: 700;
			color: #fff;
			display: flex;
			align-items: center;
			gap: 10px;
		}

		.modal-close {
			background: transparent;
			border: none;
			color: var(--text-muted);
			font-size: 18px;
			cursor: pointer;
			padding: 4px 8px;
			border-radius: 6px;
			transition: all 0.2s;
		}

		.modal-close:hover {
			color: #fff;
			background: rgba(255, 255, 255, 0.1);
		}

		.modal-body {
			padding: 24px;
		}

		.modal-footer {
			padding: 16px 24px;
			border-top: 1px solid var(--border-subtle);
			display: flex;
			justify-content: flex-end;
			gap: 12px;
			background: rgba(255, 255, 255, 0.02);
		}

		/* Form Controls */
		.form-group {
			margin-bottom: 18px;
			display: flex;
			flex-direction: column;
			gap: 6px;
		}

		.form-row {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 16px;
		}

		.form-label {
			font-size: 12px;
			font-weight: 600;
			color: var(--text-muted);
			text-transform: uppercase;
			letter-spacing: 0.5px;
		}

		.form-control,
		.form-select {
			width: 100%;
			padding: 11px 16px;
			background: rgba(255, 255, 255, 0.05);
			border: 1px solid var(--border-card);
			border-radius: 10px;
			color: #fff;
			font-family: 'Inter', sans-serif;
			font-size: 14px;
			transition: all 0.2s ease;
			outline: none;
		}

		.form-control:focus,
		.form-select:focus {
			border-color: var(--gold);
			background: rgba(212, 160, 23, 0.05);
			box-shadow: 0 0 12px rgba(212, 160, 23, 0.15);
		}

		.form-select option {
			background: #14141e;
			color: #fff;
		}

		.btn-danger {
			background: linear-gradient(135deg, #dc2626, #7f1d1d);
			color: #fff;
			border: 1px solid rgba(239, 68, 68, 0.3);
		}
		.btn-danger:hover {
			box-shadow: 0 4px 16px rgba(220, 38, 38, 0.4);
			transform: translateY(-1px);
		}
	</style>
	{% block stylesheets %}{% endblock %}
</head>
<body>
	<!-- Sidebar Navigation -->
	<aside class="sidebar">
		<div class="brand-header">
			<div class="brand-logo">
				<img src="{{ asset('images/icon.png') }}" alt="CODIS Logo">
			</div>
			<div>
				<div class="brand-title">CODIS</div>
				<div class="brand-sub">Colonne Distribution</div>
			</div>
		</div>

		<div class="nav-section-label">Menu Principal</div>
		<ul
			class="nav-links">
			<!-- Vue Générale -->
			<li class="nav-item {% if app.request.attributes.get('_route') == 'app_dashboard' %}active{% endif %}">
				<a href="{{ path('app_dashboard') }}">
					<i class="fa-solid fa-chart-pie"></i>
					<span>Vue Générale</span>
				</a>
			</li>

			<!-- Réseau Commercial -->
			<li class="nav-item has-submenu {% if app.request.attributes.get('_route') == 'app_commercial_index' %}open{% endif %}">
				<div class="nav-item-header" onclick="toggleSubmenu(this)">
					<div class="header-left">
						<i class="fa-solid fa-network-wired icon-main"></i>
						<span>Réseau Commercial</span>
					</div>
					<i class="fa-solid fa-chevron-down chevron"></i>
				</div>
				<ul class="submenu">
					<li class="submenu-item {% if app.request.attributes.get('_route') == 'app_commercial_index' and app.request.query.get('tab') == 'grossistes' %}active{% endif %}">
						<a href="{{ path('app_commercial_index', {tab: 'grossistes'}) }}">
							<i class="fa-solid fa-building"></i>
							<span>Grossistes Agréés</span>
						</a>
					</li>
					<li class="submenu-item {% if app.request.attributes.get('_route') == 'app_commercial_index' and app.request.query.get('tab') == 'detailants' %}active{% endif %}">
						<a href="{{ path('app_commercial_index', {tab: 'detailants'}) }}">
							<i class="fa-solid fa-shop"></i>
							<span>Détaillants & Points de Vente</span>
						</a>
					</li>
					<li class="submenu-item {% if app.request.attributes.get('_route') == 'app_commercial_index' and app.request.query.get('tab') == 'agents' %}active{% endif %}">
						<a href="{{ path('app_commercial_index', {tab: 'agents'}) }}">
							<i class="fa-solid fa-users"></i>
							<span>Agents Commercial</span>
						</a>
					</li>
				</ul>
			</li>

			<!-- Ventes & Logistique -->
			<li class="nav-item has-submenu {% if app.request.attributes.get('_route') in ['app_commande_index', 'app_livraison_index', 'app_paiement_index', 'app_consignation_index'] %}open{% endif %}">
				<div class="nav-item-header" onclick="toggleSubmenu(this)">
					<div class="header-left">
						<i class="fa-solid fa-cart-shopping icon-main"></i>
						<span>Ventes & Logistique</span>
					</div>
					<i class="fa-solid fa-chevron-down chevron"></i>
				</div>
				<ul class="submenu">
					<li class="submenu-item {% if app.request.attributes.get('_route') == 'app_consignation_index' %}active{% endif %}">
						<a href="{{ path('app_consignation_index') }}">
							<i class="fa-solid fa-clipboard-check"></i>
							<span>Consignations & Tournées DR</span>
						</a>
					</li>
					<li class="submenu-item {% if app.request.attributes.get('_route') == 'app_commande_index' %}active{% endif %}">
						<a href="{{ path('app_commande_index') }}">
							<i class="fa-solid fa-file-invoice-dollar"></i>
							<span>Commandes Clients</span>
						</a>
					</li>
					<li class="submenu-item {% if app.request.attributes.get('_route') == 'app_livraison_index' %}active{% endif %}">
						<a href="{{ path('app_livraison_index') }}">
							<i class="fa-solid fa-truck-fast"></i>
							<span>Livraisons & Transit</span>
						</a>
					</li>
					<li class="submenu-item {% if app.request.attributes.get('_route') == 'app_paiement_index' %}active{% endif %}">
						<a href="{{ path('app_paiement_index') }}">
							<i class="fa-solid fa-credit-card"></i>
							<span>Paiements & Crédits</span>
						</a>
					</li>
				</ul>
			</li>

			<!-- Industrie & Stocks -->
			<li class="nav-item has-submenu {% if app.request.attributes.get('_route') in ['app_production_index', 'app_stock_index', 'app_catalogue_index'] %}open{% endif %}">
				<div class="nav-item-header" onclick="toggleSubmenu(this)">
					<div class="header-left">
						<i class="fa-solid fa-boxes-stacked icon-main"></i>
						<span>Industrie & Stocks</span>
					</div>
					<i class="fa-solid fa-chevron-down chevron"></i>
				</div>
				<ul
					class="submenu">
					{# <li class="submenu-item {% if app.request.attributes.get('_route') == 'app_catalogue_index' %}active{% endif %}">
											<a href="{{ path('app_catalogue_index') }}">
												<i class="fa-solid fa-boxes-packing"></i>
												<span>Catalogue & Produits</span>
											</a>
										</li> #}
					<li class="submenu-item {% if app.request.attributes.get('_route') == 'app_production_index' %}active{% endif %}">
						<a href="{{ path('app_production_index') }}">
							<i class="fa-solid fa-industry"></i>
							<span>Production & Usines</span>
						</a>
					</li>
					<li class="submenu-item {% if app.request.attributes.get('_route') == 'app_stock_index' and app.request.query.get('tab', 'synthese') == 'synthese' %}active{% endif %}">
						<a href="{{ path('app_stock_index', {tab: 'synthese'}) }}">
							<i class="fa-solid fa-boxes-packing"></i>
							<span>Synthèse par Produit</span>
						</a>
					</li>
					<li class="submenu-item {% if app.request.attributes.get('_route') == 'app_stock_index' and app.request.query.get('tab') == 'detail' %}active{% endif %}">
						<a href="{{ path('app_stock_index', {tab: 'detail'}) }}">
							<i class="fa-solid fa-layer-group"></i>
							<span>Détail par Emplacement & Lot</span>
						</a>
					</li>
					<li class="submenu-item {% if app.request.attributes.get('_route') == 'app_stock_index' and app.request.query.get('tab') == 'mouvements' %}active{% endif %}">
						<a href="{{ path('app_stock_index', {tab: 'mouvements'}) }}">
							<i class="fa-solid fa-timeline"></i>
							<span>Historique Mouvements</span>
						</a>
					</li>
				</ul>
			</li>

			<!-- Administration -->
			<li class="nav-item has-submenu {% if app.request.attributes.get('_route') in ['app_utilisateur_index', 'app_audit_index'] %}open{% endif %}">
				<div class="nav-item-header" onclick="toggleSubmenu(this)">
					<div class="header-left">
						<i class="fa-solid fa-shield-halved icon-main"></i>
						<span>Administration</span>
					</div>
					<i class="fa-solid fa-chevron-down chevron"></i>
				</div>
				<ul class="submenu">
					<li class="submenu-item {% if app.request.attributes.get('_route') == 'app_utilisateur_index' %}active{% endif %}">
						<a href="{{ path('app_utilisateur_index') }}">
							<i class="fa-solid fa-users-gear"></i>
							<span>Utilisateurs & Accès</span>
						</a>
					</li>
					<li class="submenu-item {% if app.request.attributes.get('_route') == 'app_audit_index' %}active{% endif %}">
						<a href="{{ path('app_audit_index') }}">
							<i class="fa-solid fa-clock-rotate-left"></i>
							<span>Audit & Traçabilité</span>
						</a>
					</li>

					<li class="submenu-item {% if app.request.attributes.get('_route') == 'app_catalogue_index' %}active{% endif %}">
						<a href="{{ path('app_catalogue_index') }}">
							<i class="fa-solid fa-boxes-packing"></i>
							<span>Catalogue & Produits</span>
						</a>
					</li>
				</ul>
			</li>
		</ul>

		<div class="sidebar-footer">
			<span class="version">
				<i class="fa-solid fa-circle" style="font-size: 6px; color: #34d399;"></i>
				CODIS v2.0</span>
		</div>
	</aside>

	<!-- Main Body Area -->
	<main class="main-content">
		<div class="topbar">
			<div>
				<h1 class="page-title">
					{% block page_title %}Tableau de Bord
					{% endblock %}
				</h1>
				<p class="page-subtitle">
					{% block page_subtitle %}Supervision en temps réel de la distribution
					{% endblock %}
				</p>
			</div>
			<div style="display: flex; gap: 12px; align-items: center;">
				<div class="user-badge">
					<i class="fa-solid fa-circle-user" style="color: var(--gold); font-size: 20px;"></i>
					<span style="font-size: 13px; font-weight: 600;">
						{% if app.user %}
							{{ app.user.nomComplet }}
							({{ app.user.username }})
						{% else %}
							Direction Générale
						{% endif %}
					</span>
					<span class="badge badge-success" style="font-size: 10px;">
						<i class="fa-solid fa-circle" style="font-size: 5px;"></i>
						EN LIGNE</span>
				</div>
				{% if app.user %}
					<a href="{{ path('app_logout') }}" class="btn btn-outline btn-sm" title="Se déconnecter" style="border-color: rgba(239, 68, 68, 0.3); color: #f87171;">
						<i class="fa-solid fa-right-from-bracket"></i>
						Déconnexion</a>
				{% else %}
					<a href="{{ path('app_login') }}" class="btn btn-gold btn-sm">
						<i class="fa-solid fa-right-to-bracket"></i>
						Connexion</a>
				{% endif %}
			</div>
		</div>

		{% for message in app.flashes('success') %}
			<div class="alert alert-success">
				<i class="fa-solid fa-circle-check"></i>
				{{ message }}</div>
		{% endfor %}
		{% for message in app.flashes('info') %}
			<div class="alert alert-info">
				<i class="fa-solid fa-circle-info"></i>
				{{ message }}</div>
		{% endfor %}

		{% block body %}{% endblock %}
	</main>

	<script>
		function toggleSubmenu(el) {
const navItem = el.closest('.nav-item');
if (navItem) 
navItem.classList.toggle('open');


}
function openModal(id) {
const modal = document.getElementById(id);
if (modal) 
modal.classList.add('active');


}
function closeModal(id) {
const modal = document.getElementById(id);
if (modal) 
modal.classList.remove('active');


}
document.addEventListener('click', function (e) {
if (e.target.classList.contains('modal-backdrop')) {
e.target.classList.remove('active');
}
});
	</script>
	{% block javascripts %}{% endblock %}
</body></html>
