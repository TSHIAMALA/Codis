<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>
			{% block title %}CODIS - Colonne Distribution System
			{% endblock %}
		</title>
		<!-- Favicon -->
		<link rel="icon" type="image/png" href="{{ asset('images/icon.png') }}">
		<link rel="shortcut icon" type="image/png" href="{{ asset('images/icon.png') }}">
		<link
		rel="apple-touch-icon" href="{{ asset('images/icon.png') }}">
		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link
		href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">
		<!-- FontAwesome & Tabler Icons -->
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

		<!-- Immediate theme initialization script to prevent FOUC -->
		<script>
			(function() {
				const savedTheme = localStorage.getItem('codis_theme') || 'light';
				document.documentElement.setAttribute('data-theme', savedTheme);
			})();
		</script>

		<link rel="stylesheet" href="{{ asset('styles/codis.css') }}">
	{% block stylesheets %}{% endblock %}
</head>
<body>
	<!-- Sidebar Navigation -->
	<aside class="sidebar">
		<div class="brand-header">
			<div class="brand-logo">
				<img src="{{ asset('images/icon.png') }}" alt="CODIS Logo">
			</div>
			<div>
				<div class="brand-title">CODIS</div>
				<div class="brand-sub">Colonne Distribution</div>
			</div>
		</div>

		{% set route = app.request.attributes.get('_route') %}
		{% set tab = app.request.query.get('tab') %}
		<div class="nav-section-label">Menu Principal</div>
		<ul
			class="nav-links">
			<!-- Vue Générale -->
			{% if is_granted('ROLE_STAFF') %}
				<li class="nav-item {% if route in ['app_dashboard', 'app_home'] %}active{% endif %}">
					<a href="{{ path('app_dashboard') }}">
						<i class="fa-solid fa-chart-pie"></i>
						<span>Vue Générale</span>
					</a>
				</li>
			{% endif %}

			<!-- Réseau Commercial -->
			{% if is_granted('ROLE_DELEGUE') %}
				<li class="nav-item has-submenu {% if route == 'app_commercial_index' %}open{% endif %}">
					<div class="nav-item-header" onclick="toggleSubmenu(this)">
						<div class="header-left">
							<i class="fa-solid fa-network-wired icon-main"></i>
							<span>Réseau Commercial</span>
						</div>
						<i class="fa-solid fa-chevron-down chevron"></i>
					</div>
					<ul class="submenu">
						<li class="submenu-item {% if route == 'app_commercial_index' and tab == 'grossistes' %}active{% endif %}">
							<a href="{{ path('app_commercial_index', {tab: 'grossistes'}) }}">
								<i class="fa-solid fa-building"></i>
								<span>Grossistes Agréés</span>
							</a>
						</li>
						<li class="submenu-item {% if route == 'app_commercial_index' and tab == 'detailants' %}active{% endif %}">
							<a href="{{ path('app_commercial_index', {tab: 'detailants'}) }}">
								<i class="fa-solid fa-shop"></i>
								<span>Détaillants & Points de Vente</span>
							</a>
						</li>
						<li class="submenu-item {% if route == 'app_commercial_index' and tab == 'agents' %}active{% endif %}">
							<a href="{{ path('app_commercial_index', {tab: 'agents'}) }}">
								<i class="fa-solid fa-users"></i>
								<span>Agents Commercial</span>
							</a>
						</li>
					</ul>
				</li>
			{% endif %}

			<!-- Ventes & Logistique -->
			{% if is_granted('ROLE_STAFF') %}
				<li class="nav-item has-submenu {% if route in ['app_commande_index', 'app_commande_show', 'app_livraison_index', 'app_paiement_index', 'app_consignation_index', 'app_tarif_index'] %}open{% endif %}">
					<div class="nav-item-header" onclick="toggleSubmenu(this)">
						<div class="header-left">
							<i class="fa-solid fa-cart-shopping icon-main"></i>
							<span>Ventes & Logistique</span>
						</div>
						<i class="fa-solid fa-chevron-down chevron"></i>
					</div>
					<ul class="submenu">
						{% if is_granted('ROLE_ADMIN_PAYS') %}
							<li class="submenu-item {% if route == 'app_tarif_index' %}active{% endif %}">
								<a href="{{ path('app_tarif_index') }}">
									<i class="fa-solid fa-tags"></i>
									<span>Grille des Tarifs & Prix</span>
								</a>
							</li>
						{% endif %}
						<li class="submenu-item {% if route == 'app_consignation_index' %}active{% endif %}">
							<a href="{{ path('app_consignation_index') }}">
								<i class="fa-solid fa-clipboard-check"></i>
								<span>Consignations & Tournées DR</span>
							</a>
						</li>
						{% if is_granted('ROLE_AGENT_COMMERCIAL') %}
							<li class="submenu-item {% if route in ['app_commande_index', 'app_commande_show'] %}active{% endif %}">
								<a href="{{ path('app_commande_index') }}">
									<i class="fa-solid fa-file-invoice-dollar"></i>
									<span>Commandes Clients</span>
								</a>
							</li>
						{% endif %}
						{% if is_granted('ROLE_GESTIONNAIRE_DEPOT') %}
							<li class="submenu-item {% if route == 'app_livraison_index' %}active{% endif %}">
								<a href="{{ path('app_livraison_index') }}">
									<i class="fa-solid fa-truck-fast"></i>
									<span>Livraisons & Transit</span>
								</a>
							</li>
						{% endif %}
						{% if is_granted('ROLE_CAISSIER') %}
							<li class="submenu-item {% if route == 'app_paiement_index' %}active{% endif %}">
								<a href="{{ path('app_paiement_index') }}">
									<i class="fa-solid fa-credit-card"></i>
									<span>Paiements & Crédits</span>
								</a>
							</li>
						{% endif %}
					</ul>
				</li>
			{% endif %}

			<!-- Industrie & Stocks -->
			{% if is_granted('ROLE_STAFF') %}
				<li class="nav-item has-submenu {% if route in ['app_production_index', 'app_stock_index', 'app_catalogue_index'] %}open{% endif %}">
					<div class="nav-item-header" onclick="toggleSubmenu(this)">
						<div class="header-left">
							<i class="fa-solid fa-boxes-stacked icon-main"></i>
							<span>Industrie & Stocks</span>
						</div>
						<i class="fa-solid fa-chevron-down chevron"></i>
					</div>
					<ul class="submenu">
						<li class="submenu-item {% if route == 'app_catalogue_index' %}active{% endif %}">
							<a href="{{ path('app_catalogue_index') }}">
								<i class="fa-solid fa-boxes-packing"></i>
								<span>Catalogue & Produits</span>
							</a>
						</li>
						{% if is_granted('ROLE_RESPONSABLE_USINE') %}
							<li class="submenu-item {% if route == 'app_production_index' %}active{% endif %}">
								<a href="{{ path('app_production_index') }}">
									<i class="fa-solid fa-industry"></i>
									<span>Production & Usines</span>
								</a>
							</li>
						{% endif %}
						<li class="submenu-item {% if route == 'app_stock_index' and app.request.query.get('tab', 'synthese') == 'synthese' %}active{% endif %}">
							<a href="{{ path('app_stock_index', {tab: 'synthese'}) }}">
								<i class="fa-solid fa-cubes"></i>
								<span>Synthèse par Produit</span>
							</a>
						</li>
						<li class="submenu-item {% if route == 'app_stock_index' and tab == 'detail' %}active{% endif %}">
							<a href="{{ path('app_stock_index', {tab: 'detail'}) }}">
								<i class="fa-solid fa-layer-group"></i>
								<span>Détail par Emplacement & Lot</span>
							</a>
						</li>
						<li class="submenu-item {% if route == 'app_stock_index' and tab == 'mouvements' %}active{% endif %}">
							<a href="{{ path('app_stock_index', {tab: 'mouvements'}) }}">
								<i class="fa-solid fa-timeline"></i>
								<span>Historique Mouvements</span>
							</a>
						</li>
					</ul>
				</li>
			{% endif %}

			<!-- Administration -->
			{% if is_granted('ROLE_ADMIN_PAYS') %}
				{% set nbDemandes = demandes_acces_count() %}
				<li class="nav-item has-submenu {% if route in ['app_utilisateur_index', 'app_audit_index'] or nbDemandes > 0 %}open{% endif %}">
					<div class="nav-item-header" onclick="toggleSubmenu(this)">
						<div class="header-left">
							<i class="fa-solid fa-shield-halved icon-main"></i>
							<span>Administration</span>
						</div>
						<i class="fa-solid fa-chevron-down chevron"></i>
					</div>
					<ul class="submenu">
						<li class="submenu-item {% if route == 'app_utilisateur_index' %}active{% endif %}">
							<a href="{{ path('app_utilisateur_index') }}" style="display: flex; align-items: center;">
								<i class="fa-solid fa-users-gear"></i>
								<span>Utilisateurs & Accès</span>
								{% if nbDemandes > 0 %}
									<span class="nav-count" title="{{ nbDemandes }} demande(s) d'accès en attente">{{ nbDemandes }}</span>
								{% endif %}
							</a>
						</li>
						{% if is_granted('ROLE_SUPER_ADMIN') %}
							<li class="submenu-item {% if route == 'app_audit_index' %}active{% endif %}">
								<a href="{{ path('app_audit_index') }}">
									<i class="fa-solid fa-clock-rotate-left"></i>
									<span>Audit & Traçabilité</span>
								</a>
							</li>
						{% endif %}
					</ul>
				</li>
			{% endif %}
		</ul>

		<div class="sidebar-footer">
			<span class="version">
				<i class="fa-solid fa-circle" style="font-size: 6px; color: #34d399;"></i>
				CODIS v2.0</span>
		</div>
	</aside>

	<!-- Main Body Area -->
	<main class="main-content">
		<div class="topbar">
			<div>
				<h1 class="page-title">
					{% block page_title %}Tableau de Bord
					{% endblock %}
				</h1>
				<p class="page-subtitle">
					{% block page_subtitle %}Supervision en temps réel de la distribution
					{% endblock %}
				</p>
			</div>
			<div style="display: flex; gap: 12px; align-items: center;">
				<!-- Sélecteur de Thème (Clair / Sombre) -->
				<div class="theme-switcher" id="themeSwitcher" title="Changer le thème">
					<button type="button" class="theme-switcher-btn" id="themeLightBtn" onclick="setTheme('light')" title="Mode Clair">
						<i class="fa-solid fa-sun text-warning"></i>
						<span>Clair</span>
					</button>
					<button type="button" class="theme-switcher-btn" id="themeDarkBtn" onclick="setTheme('dark')" title="Mode Sombre">
						<i class="fa-solid fa-moon" style="color: #818cf8;"></i>
						<span>Sombre</span>
					</button>
				</div>

				{% if app.user %}
					<div class="user-badge" title="Connecté en tant que {{ app.user.username }}">
						<i class="fa-solid fa-circle-user" style="color: var(--gold); font-size: 20px;"></i>
						<span style="font-size: 13px; font-weight: 600;">{{ app.user.nomComplet }}</span>
						{% set roleEntity = app.user.rolesEntities|first %}
						<span class="role-chip">{{ roleEntity ? roleEntity.libelle : 'Sans rôle' }}</span>
					</div>
					<a href="{{ logout_path() }}" class="btn btn-outline btn-sm" title="Se déconnecter" style="border-color: rgba(239, 68, 68, 0.3); color: #f87171;">
						<i class="fa-solid fa-right-from-bracket"></i>
						Déconnexion</a>
				{% endif %}
			</div>
		</div>

		{% set flashIcons = {success: 'fa-circle-check', info: 'fa-circle-info', warning: 'fa-triangle-exclamation', danger: 'fa-circle-exclamation'} %}
		{% for type, messages in app.flashes(['danger', 'warning', 'success', 'info']) %}
			{% for message in messages %}
				<div class="alert alert-{{ type }}" role="{{ type in ['danger', 'warning'] ? 'alert' : 'status' }}">
					<i class="fa-solid {{ flashIcons[type] }}"></i>
					<span class="alert-text">{{ message }}</span>
					<button type="button" class="alert-close" onclick="this.closest('.alert').remove()" title="Fermer" aria-label="Fermer"><i class="fa-solid fa-xmark"></i></button>
				</div>
			{% endfor %}
		{% endfor %}

		{% block body %}{% endblock %}
	</main>

	<script src="{{ asset('scripts/codis.js') }}"></script>
	{% block javascripts %}{% endblock %}
</body></html>
