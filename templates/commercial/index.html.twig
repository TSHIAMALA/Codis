                <th>Fonction</th>
                <th>Supérieur hiérarchique</th>
                <th>Pays / Région</th>
                <th>Statut</th>
                <th style="text-align: right;">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for a in agents %}
            <tr>
                <td class="font-bold">{{ a.utilisateur ? a.utilisateur.nomComplet : '-' }}</td>
                <td>{{ a.utilisateur ? a.utilisateur.username : '-' }}</td>
                <td><span class="badge {{ a.typeAgent in ['ASM', 'SUPERVISEUR'] ? 'badge-gold' : 'badge-info' }}">{{ a.typeAgentLibelle }}</span></td>
                <td>
                    {% if a.superviseur and a.superviseur.utilisateur %}
                        {{ a.superviseur.utilisateur.nomComplet }} <span style="font-size: 11px; color: var(--text-muted);">({{ a.superviseur.typeAgent }})</span>
                    {% elseif a.typeAgent == 'ASM' %}
                        <span style="color: var(--text-muted);">— (sommet du réseau)</span>
                    {% else %}
                        <span class="badge badge-warning" title="Sans supérieur, ses demandes de prélèvement ne peuvent être validées que par un ASM ou un administrateur">Non rattaché</span>
                    {% endif %}
                </td>
                <td>{{ a.pays ? a.pays.nom : '' }}{% if a.region %} ({{ a.region.nom }}){% endif %}</td>
                <td>
                    {% if a.actif %}
                        <span class="badge badge-success">Actif</span>
                    {% else %}
                        <span class="badge badge-danger">Inactif</span>
                    {% endif %}
                </td>
                <td style="text-align: right;">
                    <button onclick="openModal('modalEditAgent{{ a.id }}')" class="btn btn-outline btn-sm" title="Modifier"><i class="fa-solid fa-pen-to-square"></i></button>
                    <button onclick="openModal('modalDeleteAgent{{ a.id }}')" class="btn btn-danger btn-sm" title="Suppression logique"><i class="fa-solid fa-user-slash"></i></button>
                </td>
            </tr>
            {% else %}
            <tr><td colspan="7" style="text-align: center; color: var(--text-muted); padding: 32px;">Aucun agent commercial.</td></tr>
            {% endfor %}
        </tbody>
    </table>
</div>

{# Champs communs : fonction, supérieur (filtré selon la fonction), région #}
{% macro profilAgent(agents, regions, typesAgent, agent = null) %}
    {% set prefixe = agent ? 'edit' ~ agent.id : 'add' %}
    <div class="form-row">
        <div class="form-group">
            <label class="form-label">Fonction *</label>
            <select name="typeAgent" class="form-select" required data-agent-type="{{ prefixe }}" onchange="filtrerSuperieurs('{{ prefixe }}')">
                {% if not agent %}<option value="">-- Choisir --</option>{% endif %}
                {% for t in typesAgent %}
                    <option value="{{ t }}" {% if agent and agent.typeAgent == t %}selected{% endif %}>{{ {ASM: 'ASM (Area Sales Manager)', SUPERVISEUR: 'Superviseur des Ventes', DR: 'DR (Distribution Representative)', CYCLO: 'Cyclo (Vendeur Ambulant)'}[t] }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="form-group">
            <label class="form-label">Supérieur hiérarchique</label>
            <select name="superviseur_id" class="form-select" data-agent-sup="{{ prefixe }}">
                <option value="">-- Aucun --</option>
                {% for s in agents|filter(s => s.actif and s.typeAgent != 'CYCLO' and (not agent or s.id != agent.id)) %}
                    <option value="{{ s.id }}" data-type="{{ s.typeAgent }}" {% if agent and agent.superviseur and agent.superviseur.id == s.id %}selected{% endif %}>{{ s.utilisateur.nomComplet }} — {{ s.typeAgent }}</option>
                {% endfor %}
            </select>
            <div style="font-size: 11px; color: var(--text-muted); margin-top: 4px;" data-agent-aide="{{ prefixe }}"></div>
        </div>
    </div>
    <div class="form-group">
        <label class="form-label">Région</label>
        <select name="region_id" class="form-select">
            <option value="">-- Non précisée --</option>
            {% for r in regions %}
                <option value="{{ r.id }}" {% if agent and agent.region and agent.region.id == r.id %}selected{% endif %}>{{ r.nom }}</option>
            {% endfor %}
        </select>
    </div>
{% endmacro %}

<!-- Agents Modals (Rendered Outside Table) -->
{% for a in agents %}
<div id="modalEditAgent{{ a.id }}" class="modal-backdrop">
    <div class="modal-content">
        <div class="modal-header">
            <div class="modal-title"><i class="fa-solid fa-user-pen text-gold"></i> Modifier Agent Commercial — {{ a.utilisateur ? a.utilisateur.nomComplet : '' }}</div>
            <button onclick="closeModal('modalEditAgent{{ a.id }}')" class="modal-close"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <form method="post" action="{{ path('app_agent_modifier', {id: a.id}) }}">
            {{ include('_csrf.html.twig') }}
            <div class="modal-body">
                <div class="form-group">
                    <label class="form-label">Compte Utilisateur</label>
                    <input type="text" class="form-control" value="{{ a.utilisateur ? a.utilisateur.nomComplet ~ ' (' ~ a.utilisateur.username ~ ')' : '' }}" disabled>
                </div>
                {{ _self.profilAgent(agents, regions, typesAgent, a) }}
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Délégué</label>
                        <select name="delegue_id" class="form-select">
                            <option value="">-- Aucun --</option>
                            {% for del in delegues %}
                                <option value="{{ del.id }}" {% if a.delegue and a.delegue.id == del.id %}selected{% endif %}>{{ del.utilisateur ? del.utilisateur.nomComplet : 'Délégué #' ~ del.id }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Pays de rattachement</label>
                        <select name="pays_id" class="form-select">
                            {% for p in paysList %}
                                <option value="{{ p.id }}" {% if a.pays and a.pays.id == p.id %}selected{% endif %}>{{ p.nom }}</option>
                            {% endfor %}
                        </select>
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">Statut</label>
                    <select name="actif" class="form-select">
                        <option value="1" {% if a.actif %}selected{% endif %}>ACTIF</option>
                        <option value="0" {% if not a.actif %}selected{% endif %}>INACTIF</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" onclick="closeModal('modalEditAgent{{ a.id }}')" class="btn btn-outline">Annuler</button>
                <button type="submit" class="btn btn-gold"><i class="fa-solid fa-floppy-disk"></i> Enregistrer</button>
            </div>
        </form>
    </div>
</div>

<div id="modalDeleteAgent{{ a.id }}" class="modal-backdrop">
    <div class="modal-content" style="max-width: 450px;">
        <div class="modal-header">
            <div class="modal-title text-red"><i class="fa-solid fa-triangle-exclamation"></i> Désactivation d'Agent</div>
            <button onclick="closeModal('modalDeleteAgent{{ a.id }}')" class="modal-close"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <form method="post" action="{{ path('app_agent_supprimer', {id: a.id}) }}">
            {{ include('_csrf.html.twig') }}
            <div class="modal-body">
                <p style="font-size: 14px; line-height: 1.6; color: var(--text-main);">
                    Voulez-vous désactiver l'agent commercial <strong class="text-gold">{{ a.utilisateur ? a.utilisateur.nomComplet : '' }}</strong> ?
                </p>
                <p style="font-size: 12px; color: var(--text-muted); margin-top: 8px;">
                    L'agent sera marqué comme <strong>INACTIF</strong> (suppression logique sans perte d'historique).
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" onclick="closeModal('modalDeleteAgent{{ a.id }}')" class="btn btn-outline">Annuler</button>
                <button type="submit" class="btn btn-danger"><i class="fa-solid fa-user-slash"></i> Confirmer Désactivation</button>
            </div>
        </form>
    </div>
</div>
{% endfor %}

<!-- Modal Add Agent -->
<div id="modalAddAgent" class="modal-backdrop">
    <div class="modal-content">
        <div class="modal-header">
            <div class="modal-title"><i class="fa-solid fa-user-plus text-gold"></i> Créer un Agent Commercial Terrain</div>
            <button onclick="closeModal('modalAddAgent')" class="modal-close"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <form method="post" action="{{ path('app_agent_nouveau') }}">
            {{ include('_csrf.html.twig') }}
            <div class="modal-body">
                <div class="form-group">
                    <label class="form-label">Compte utilisateur</label>
                    <select name="utilisateur_id" class="form-select" onchange="document.getElementById('nouveauCompteAgent').style.display = this.value ? 'none' : 'block'; document.querySelectorAll('#nouveauCompteAgent [data-requis]').forEach(function(i) { i.required = !this.value; }, this);">
                        <option value="">Créer un nouveau compte</option>
                        {% for u in comptesSansProfil %}
                            <option value="{{ u.id }}">{{ u.nomComplet }} ({{ u.username }})</option>
                        {% endfor %}
                    </select>
                    <div style="font-size: 11px; color: var(--text-muted); margin-top: 4px;">Comptes actifs n'ayant pas encore de profil d'agent. Le rôle « Agent commercial » est ajouté si le compte n'a aucun rôle commercial.</div>
                </div>
                <div id="nouveauCompteAgent">
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">Nom *</label>
                            <input type="text" name="nom" class="form-control" placeholder="ex: ILUNGA" required data-requis>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Prénom</label>
                            <input type="text" name="prenom" class="form-control" placeholder="ex: Patrick">
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">Nom d'utilisateur *</label>
                            <input type="text" name="username" class="form-control" placeholder="ex: pilunga" required data-requis>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Mot de passe *</label>
                            <input type="password" name="password" class="form-control" placeholder="8 caractères minimum" minlength="8" autocomplete="new-password" required data-requis>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">Email</label>
                            <input type="email" name="email" class="form-control" placeholder="patrick@codis.cd">
                        </div>
                        <div class="form-group">
                            <label class="form-label">Téléphone</label>
                            <input type="text" name="telephone" class="form-control" placeholder="+243 810 000 000">
                        </div>
                    </div>
                </div>
                {{ _self.profilAgent(agents, regions, typesAgent) }}
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Délégué</label>
                        <select name="delegue_id" class="form-select">
                            <option value="">-- Aucun --</option>
                            {% for del in delegues %}
                                <option value="{{ del.id }}">{{ del.utilisateur ? del.utilisateur.nomComplet : 'Délégué #' ~ del.id }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Pays</label>
                        <select name="pays_id" class="form-select">
                            {% for p in paysList %}
                                <option value="{{ p.id }}">{{ p.nom }} ({{ p.devise }})</option>
                            {% endfor %}
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" onclick="closeModal('modalAddAgent')" class="btn btn-outline">Annuler</button>
                <button type="submit" class="btn btn-gold"><i class="fa-solid fa-user-check"></i> Créer Agent Commercial</button>
            </div>
        </form>
    </div>
</div>

<script>
// Le supérieur proposé dépend de la fonction : DR → Superviseur, Superviseur → ASM, Cyclo → DR, ASM → aucun
var typeSuperieur = {SUPERVISEUR: 'ASM', DR: 'SUPERVISEUR', CYCLO: 'DR'};
function filtrerSuperieurs(prefixe) {
    var type = document.querySelector('[data-agent-type="' + prefixe + '"]').value;
    var select = document.querySelector('[data-agent-sup="' + prefixe + '"]');
    var aide = document.querySelector('[data-agent-aide="' + prefixe + '"]');
    var attendu = typeSuperieur[type] || null;
    select.querySelectorAll('option[data-type]').forEach(function(o) {
        o.hidden = o.dataset.type !== attendu;
        if (o.hidden && o.selected) { select.value = ''; }
    });
    select.disabled = !attendu;
    aide.textContent = attendu ? 'Un ' + type + ' est rattaché à un ' + attendu + '.' : (type === 'ASM' ? 'Un ASM est au sommet du réseau commercial.' : '');
}
document.querySelectorAll('[data-agent-type]').forEach(function(s) { filtrerSuperieurs(s.dataset.agentType); });
</script>
{% endif %}
{% endblock %}