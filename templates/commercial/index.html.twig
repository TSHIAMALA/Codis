</div>

<div id="modalDeleteDetailant{{ d.id }}" class="modal-backdrop">
    <div class="modal-content" style="max-width: 450px;">
        <div class="modal-header">
            <div class="modal-title text-red"><i class="fa-solid fa-triangle-exclamation"></i> Suppression Logique</div>
            <button onclick="closeModal('modalDeleteDetailant{{ d.id }}')" class="modal-close"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <form method="post" action="{{ path('app_detailant_supprimer', {id: d.id}) }}">
            {{ include('_csrf.html.twig') }}
            <div class="modal-body">
                <p style="font-size: 14px; line-height: 1.6; color: var(--text-main);">
                    Voulez-vous désactiver le détaillant <strong class="text-gold">{{ d.nom }}</strong> ?
                </p>
                <p style="font-size: 12px; color: var(--text-muted); margin-top: 8px;">
                    L'enregistrement sera marqué comme <strong>INACTIF</strong> (suppression logique sans perte d'historique).
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" onclick="closeModal('modalDeleteDetailant{{ d.id }}')" class="btn btn-outline">Annuler</button>
                <button type="submit" class="btn btn-danger"><i class="fa-solid fa-ban"></i> Confirmer Désactivation</button>
            </div>
        </form>
    </div>
</div>
{% endfor %}

<!-- Modal Add Detailant -->
<div id="modalAddDetailant" class="modal-backdrop">
    <div class="modal-content">
        <div class="modal-header">
            <div class="modal-title"><i class="fa-solid fa-shop text-gold"></i> Nouveau Point de Vente / Détaillant</div>
            <button onclick="closeModal('modalAddDetailant')" class="modal-close"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <form method="post" action="{{ path('app_detailant_nouveau') }}">
            {{ include('_csrf.html.twig') }}
            <div class="modal-body">
                <div class="form-group">
                    <label class="form-label">Nom / Enseigne *</label>
                    <input type="text" name="nom" class="form-control" placeholder="ex: Alimentation Générale Kintambo" required>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Nom du Responsable</label>
                        <input type="text" name="nomResponsable" class="form-control" placeholder="ex: M. Kabamba">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Téléphone</label>
                        <input type="text" name="telephone" class="form-control" placeholder="ex: +243 990 000 000">
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">Email</label>
                    <input type="email" name="email" class="form-control" placeholder="kintambo@gmail.com">
                </div>
                {{ _self.localisationDetailant(paysList, regions) }}
                <div class="form-group">
                    <label class="form-label">Adresse Physique</label>
                    <input type="text" name="adresse" class="form-control" placeholder="Av. Kasavubu, N° 45">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" onclick="closeModal('modalAddDetailant')" class="btn btn-outline">Annuler</button>
                <button type="submit" class="btn btn-gold"><i class="fa-solid fa-plus"></i> Enregistrer Détaillant</button>
            </div>
        </form>
    </div>
</div>
<script>
// N'affiche que les régions du pays choisi ; vide la région si elle n'appartient plus au pays.
function filtrerRegions(paysSelect) {
    var region = paysSelect.closest('form').querySelector('[data-region-select]');
    if (!region) { return; }
    region.querySelectorAll('option[data-pays]').forEach(function(o) {
        o.hidden = o.dataset.pays !== paysSelect.value;
        if (o.hidden && o.selected) { region.value = ''; }
    });
}
document.querySelectorAll('[data-region-select]').forEach(function(r) {
    var pays = r.closest('form').querySelector('select[name="pays_id"]');
    if (pays) { filtrerRegions(pays); }
});
</script>
{% endif %}

