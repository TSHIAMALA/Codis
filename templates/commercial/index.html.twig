    <div class="modal-content">
        <div class="modal-header">
            <div class="modal-title"><i class="fa-solid fa-pen-to-square text-gold"></i> Modifier Détaillant — {{ d.nom }}</div>
            <button onclick="closeModal('modalEditDetailant{{ d.id }}')" class="modal-close"><i class="fa-solid fa-xmark"></i></button>
