            {{ include('_csrf.html.twig') }}
            <div class="modal-body">
                <div class="form-group">
                    <label class="form-label">Nom / Enseigne Point de Vente</label>
                    <input type="text" name="nom" class="form-control" value="{{ d.nom }}" required>
