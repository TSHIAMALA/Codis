            <span class="badge badge-gold">{{ detailants|length }} clients</span>
            <button onclick="openModal('modalAddDetailant')" class="btn btn-gold btn-sm"><i class="fa-solid fa-plus"></i> Nouveau Détaillant</button>
        </div>
    </div>

    <table class="custom-table">
        <thead>
            <tr>
                <th>Code</th>
                <th>Point de Vente</th>
                <th>Responsable</th>
                <th>Téléphone</th>
                <th>Adresse</th>
                <th>Statut</th>
                <th style="text-align: right;">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for d in detailants %}
