                    <button onclick="openModal('modalEditDetailant{{ d.id }}')" class="btn btn-outline btn-sm" title="Modifier"><i class="fa-solid fa-pen-to-square"></i></button>
                    <button onclick="openModal('modalDeleteDetailant{{ d.id }}')" class="btn btn-danger btn-sm" title="Suppression logique"><i class="fa-solid fa-trash-can"></i></button>
                </td>
