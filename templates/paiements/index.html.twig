{% extends 'base/base.html.twig' %}

{% block page_title %}Paiements & Suivi des Crédits{% endblock %}
{% block page_subtitle %}Règlements reçus, encours, gestion des risques et avoirs / avances clients{% endblock %}

{% block body %}
<!-- Section Comptes Clients & Avoirs / Avances -->
<div class="card-table" style="margin-bottom: 24px;">
    <div class="card-table-header">
        <div class="card-table-title"><i class="fa-solid fa-wallet text-gold"></i> Portefeuille & Avoirs Clients (Soldes & Trop-perçus)</div>
        <span class="badge badge-gold">{{ soldesGrossistes|length }} comptes suivis</span>
    </div>

    <table class="custom-table">
        <thead>
            <tr>
                <th>Grossiste / Distributeur</th>
                <th>Type Canal</th>
                <th>Total Commandes</th>
                <th>Total Règlements</th>
                <th>Situation Financière</th>
                <th style="text-align: right;">Avoir Disponible</th>
            </tr>
        </thead>
        <tbody>
            {% for s in soldesGrossistes %}
            <tr>
                <td class="font-bold">{{ s.grossiste.raisonSociale }} ({{ s.grossiste.code }})</td>
                <td><span class="badge badge-gold">{{ s.grossiste.typeDistribution|default('DISTRIBUTEUR_AGREE') }}</span></td>
                <td>{{ s.totalCommandes|number_format(2, ',', ' ') }} $</td>
                <td class="text-success font-bold">{{ s.totalPaiements|number_format(2, ',', ' ') }} $</td>
                <td>
                    {% if s.soldeCrediteur > 0 %}
                        <span class="badge badge-success"><i class="fa-solid fa-arrow-trend-up"></i> Solde Créditeur (Avance)</span>
                    {% elseif s.resteDu > 0 %}
                        <span class="badge badge-danger"><i class="fa-solid fa-clock"></i> Reste Dû : {{ s.resteDu|number_format(2, ',', ' ') }} $</span>
                    {% else %}
                        <span class="badge badge-info"><i class="fa-solid fa-check"></i> Soldé</span>
                    {% endif %}
                </td>
                <td style="text-align: right;">
                    {% if s.soldeCrediteur > 0 %}
                        <span class="badge badge-gold" style="font-size: 13px; padding: 4px 10px;">
                            <i class="fa-solid fa-piggy-bank"></i> + {{ s.soldeCrediteur|number_format(2, ',', ' ') }} $
                        </span>
                    {% else %}
                        <span style="color: var(--text-muted); font-size: 12px;">0,00 $</span>
                    {% endif %}
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<!-- Historique des règlements -->
<div class="card-table">
    <div class="card-table-header">
        <div class="card-table-title"><i class="fa-solid fa-receipt text-gold"></i> Historique des Règlements Encaissés</div>
        <div style="display: flex; gap: 10px; align-items: center;">
            <span class="badge badge-gold">{{ paiements.total }} transactions</span>
            <button onclick="openModal('modalAddPaiement')" class="btn btn-gold btn-sm"><i class="fa-solid fa-plus"></i> Enregistrer un Règlement</button>
        </div>
    </div>

    <table class="custom-table">
        <thead>
            <tr>
                <th>Date Paiement</th>
                <th>Commande</th>
                <th>Client</th>
                <th>Montant</th>
                <th>Mode</th>
                <th>Référence</th>
                <th>Statut</th>
                <th style="text-align: right;">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for p in paiements %}
            <tr>
                <td>{{ p.datePaiement ? p.datePaiement|date('d/m/Y H:i') : '-' }}</td>
                <td class="font-bold">{{ p.commande ? p.commande.numero : '-' }}</td>
                <td>{{ p.commande ? p.commande.clientNom : '-' }}</td>
                <td class="font-bold text-success">{{ p.montant|number_format(2, ',', ' ') }} $</td>
                <td><span class="badge badge-gold">{{ p.modePaiement }}</span></td>
                <td>{{ p.reference }}</td>
                <td>
                    {% if p.statut == 'VALIDE' %}
                        <span class="badge badge-success">Validé</span>
                    {% elseif p.statut == 'EN_ATTENTE' %}
                        <span class="badge badge-warning">En attente</span>
                    {% else %}
                        <span class="badge badge-danger">{{ p.statut }}</span>
                    {% endif %}
                </td>
                <td style="text-align: right;">
                    <button onclick="openModal('modalEditPaiement{{ p.id }}')" class="btn btn-outline btn-sm" title="Modifier"><i class="fa-solid fa-pen-to-square"></i></button>
                    <button onclick="openModal('modalDeletePaiement{{ p.id }}')" class="btn btn-danger btn-sm" title="Rejeter (suppression logique)"><i class="fa-solid fa-trash-can"></i></button>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {{ include('_pagination.html.twig', {page: paiements}) }}
</div>

<!-- Paiements Modals (Rendered Outside Table) -->
{% for p in paiements %}
<div id="modalEditPaiement{{ p.id }}" class="modal-backdrop">
    <div class="modal-content">
        <div class="modal-header">
            <div class="modal-title"><i class="fa-solid fa-pen-to-square text-gold"></i> Modifier Règlement — {{ p.commande ? p.commande.numero : '' }}</div>
            <button onclick="closeModal('modalEditPaiement{{ p.id }}')" class="modal-close"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <form method="post" action="{{ path('app_paiement_modifier', {id: p.id}) }}">
            {{ include('_csrf.html.twig') }}
            <div class="modal-body">
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Montant ($)</label>
                        <input type="number" step="0.01" name="montant" class="form-control" value="{{ p.montant }}" required>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Mode de Paiement</label>
                        <select name="modePaiement" class="form-select">
                            <option value="ESPECES" {% if p.modePaiement == 'ESPECES' %}selected{% endif %}>ESPECES</option>
                            <option value="MOBILE_MONEY" {% if p.modePaiement == 'MOBILE_MONEY' %}selected{% endif %}>MOBILE MONEY</option>
                            <option value="VIREMENT" {% if p.modePaiement == 'VIREMENT' %}selected{% endif %}>VIREMENT BANCAIRE</option>
                            <option value="CHEQUE" {% if p.modePaiement == 'CHEQUE' %}selected{% endif %}>CHEQUE</option>
                        </select>
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">Référence Transaction</label>
                    <input type="text" name="reference" class="form-control" value="{{ p.reference }}">
                </div>
                <div class="form-group">
                    <label class="form-label">Observation</label>
                    <input type="text" name="observation" class="form-control" value="{{ p.observation }}">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" onclick="closeModal('modalEditPaiement{{ p.id }}')" class="btn btn-outline">Annuler</button>
                <button type="submit" class="btn btn-gold"><i class="fa-solid fa-floppy-disk"></i> Enregistrer</button>
            </div>
        </form>
    </div>
</div>

<div id="modalDeletePaiement{{ p.id }}" class="modal-backdrop">
    <div class="modal-content" style="max-width: 450px;">
        <div class="modal-header">
            <div class="modal-title text-red"><i class="fa-solid fa-triangle-exclamation"></i> Rejet de Règlement</div>
            <button onclick="closeModal('modalDeletePaiement{{ p.id }}')" class="modal-close"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <form method="post" action="{{ path('app_paiement_supprimer', {id: p.id}) }}">
            {{ include('_csrf.html.twig') }}
            <div class="modal-body">
                <p style="font-size: 14px; line-height: 1.6; color: var(--text-main);">
                    Voulez-vous rejeter/invalider le paiement de <strong class="text-gold">{{ p.montant|number_format(2, ',', ' ') }} $</strong> pour la commande <strong class="text-gold">{{ p.commande ? p.commande.numero : '' }}</strong> ?
                </p>
                <p style="font-size: 12px; color: var(--text-muted); margin-top: 8px;">
                    Le statut passera à <strong>REJETE</strong> (suppression logique sans perte d'historique).
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" onclick="closeModal('modalDeletePaiement{{ p.id }}')" class="btn btn-outline">Annuler</button>
                <button type="submit" class="btn btn-danger"><i class="fa-solid fa-ban"></i> Confirmer Rejet</button>
            </div>
        </form>
    </div>
</div>
{% endfor %}

<!-- Modal Add Paiement -->
<div id="modalAddPaiement" class="modal-backdrop">
    <div class="modal-content">
        <div class="modal-header">
            <div class="modal-title"><i class="fa-solid fa-receipt text-gold"></i> Enregistrer un Règlement</div>
            <button onclick="closeModal('modalAddPaiement')" class="modal-close"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <form method="post" action="{{ path('app_paiement_nouveau') }}">
            {{ include('_csrf.html.twig') }}
            <div class="modal-body">
                <div class="form-group">
                    <label class="form-label">Commande Client *</label>
                    <select name="commande_id" class="form-select" required>
                        <option value="">-- Sélectionner la commande --</option>
                        {% for c in commandes %}
                            <option value="{{ c.id }}">{{ c.numero }} — {{ c.clientNom }} (Total: {{ c.montantTotal }} $)</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Montant Payé ($) *</label>
                        <input type="number" step="0.01" name="montant" class="form-control" placeholder="ex: 1500.00" required>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Mode de Règlement *</label>
                        <select name="modePaiement" class="form-select">
                            <option value="ESPECES">ESPECES</option>
                            <option value="MOBILE_MONEY">MOBILE MONEY (M-Pesa / Airtel Money)</option>
                            <option value="VIREMENT">VIREMENT BANCAIRE</option>
                            <option value="CHEQUE">CHEQUE</option>
                        </select>
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">N° Référence / Bordereau</label>
                    <input type="text" name="reference" class="form-control" placeholder="ex: MPESA-8923498234">
                </div>
                <div class="form-group">
                    <label class="form-label">Observation / Remarque</label>
                    <input type="text" name="observation" class="form-control" placeholder="Acompte / Avance">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" onclick="closeModal('modalAddPaiement')" class="btn btn-outline">Annuler</button>
                <button type="submit" class="btn btn-gold"><i class="fa-solid fa-plus"></i> Valider Règlement</button>
            </div>
        </form>
    </div>
</div>
{% endblock %}