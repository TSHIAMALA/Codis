{% extends 'base/base.html.twig' %}

{% block page_title %}Gestion des Utilisateurs & Rôles{% endblock %}
{% block page_subtitle %}Administration des comptes utilisateurs, accès et rôles système CODIS{% endblock %}

{% block body %}
<div class="card-table">
    <div class="card-table-header">
        <div class="card-table-title"><i class="fa-solid fa-users-gear"></i> Comptes Utilisateurs</div>
        <div style="display: flex; gap: 10px; align-items: center;">
            <span class="badge badge-gold">{{ utilisateurs|length }} comptes</span>
            <button onclick="openModal('modalAddUtilisateur')" class="btn btn-gold btn-sm"><i class="fa-solid fa-user-plus"></i> Nouveau Compte</button>
        </div>
    </div>

    <table class="custom-table">
        <thead>
            <tr>
                <th>Username</th>
                <th>Nom & Prénom</th>
                <th>Email</th>
                <th>Téléphone</th>
                <th>Pays</th>
                <th>Rôle(s)</th>
                <th>Statut</th>
                <th style="text-align: right;">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for u in utilisateurs %}
            <tr>
                <td class="font-bold text-gold">{{ u.username }}</td>
                <td class="font-bold">{{ u.nomComplet }}</td>
                <td>{{ u.email ? u.email : '-' }}</td>
                <td>{{ u.telephone ? u.telephone : '-' }}</td>
                <td>{{ u.pays ? u.pays.nom : '-' }}</td>
                <td>
                    {% for r in u.roles %}
                        <span class="badge badge-gold" style="font-size: 10px; margin-right: 2px;">{{ r }}</span>
                    {% endfor %}
                </td>
                <td>
                    {% if u.actif %}
                        <span class="badge badge-success"><i class="fa-solid fa-check" style="font-size: 9px;"></i> Actif</span>
                    {% else %}
                        <span class="badge badge-danger">Inactif</span>
                    {% endif %}
                </td>
                <td style="text-align: right;">
                    <button onclick="openModal('modalEditUtilisateur{{ u.id }}')" class="btn btn-outline btn-sm" title="Modifier"><i class="fa-solid fa-pen-to-square"></i></button>
                    {% if u.actif %}
                        <button onclick="openModal('modalDeleteUtilisateur{{ u.id }}')" class="btn btn-danger btn-sm" title="Désactiver (suppression logique)"><i class="fa-solid fa-user-slash"></i></button>
                    {% endif %}
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<!-- Utilisateurs Modals (Rendered Outside Table) -->
{% for u in utilisateurs %}
<div id="modalEditUtilisateur{{ u.id }}" class="modal-backdrop">
    <div class="modal-content">
        <div class="modal-header">
            <div class="modal-title"><i class="fa-solid fa-user-pen text-gold"></i> Modifier Compte — {{ u.username }}</div>
            <button onclick="closeModal('modalEditUtilisateur{{ u.id }}')" class="modal-close"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <form method="post" action="{{ path('app_utilisateur_modifier', {id: u.id}) }}">
            <div class="modal-body">
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Nom *</label>
                        <input type="text" name="nom" class="form-control" value="{{ u.nom }}" required>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Prénom</label>
                        <input type="text" name="prenom" class="form-control" value="{{ u.prenom }}">
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Email</label>
                        <input type="email" name="email" class="form-control" value="{{ u.email }}">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Téléphone</label>
                        <input type="text" name="telephone" class="form-control" value="{{ u.telephone }}">
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">Nouveau Mot de Passe (laisser vide si inchangé)</label>
                    <input type="password" name="password" class="form-control" placeholder="••••••••">
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Rôle Système</label>
                        <select name="role_id" class="form-select">
                            {% for r in rolesList %}
                                <option value="{{ r.id }}">{{ r.libelle }} ({{ r.code }})</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Statut du Compte</label>
                        <select name="actif" class="form-select">
                            <option value="1" {% if u.actif %}selected{% endif %}>ACTIF</option>
                            <option value="0" {% if not u.actif %}selected{% endif %}>INACTIF (Désactivé)</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" onclick="closeModal('modalEditUtilisateur{{ u.id }}')" class="btn btn-outline">Annuler</button>
                <button type="submit" class="btn btn-gold"><i class="fa-solid fa-floppy-disk"></i> Enregistrer</button>
            </div>
        </form>
    </div>
</div>

{% if u.actif %}
<div id="modalDeleteUtilisateur{{ u.id }}" class="modal-backdrop">
    <div class="modal-content" style="max-width: 450px;">
        <div class="modal-header">
            <div class="modal-title text-red"><i class="fa-solid fa-triangle-exclamation"></i> Désactivation de Compte</div>
            <button onclick="closeModal('modalDeleteUtilisateur{{ u.id }}')" class="modal-close"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <form method="post" action="{{ path('app_utilisateur_supprimer', {id: u.id}) }}">
            <div class="modal-body">
                <p style="font-size: 14px; line-height: 1.6; color: var(--text-main);">
                    Voulez-vous désactiver l'utilisateur <strong class="text-gold">{{ u.username }}</strong> ({{ u.nomComplet }}) ?
                </p>
                <p style="font-size: 12px; color: var(--text-muted); margin-top: 8px;">
                    Le compte sera marqué comme <strong>INACTIF</strong> et ne pourra plus se connecter (suppression logique).
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" onclick="closeModal('modalDeleteUtilisateur{{ u.id }}')" class="btn btn-outline">Annuler</button>
                <button type="submit" class="btn btn-danger"><i class="fa-solid fa-user-slash"></i> Désactiver Compte</button>
            </div>
        </form>
    </div>
</div>
{% endif %}
{% endfor %}

<!-- Modal Add Utilisateur -->
<div id="modalAddUtilisateur" class="modal-backdrop">
    <div class="modal-content">
        <div class="modal-header">
            <div class="modal-title"><i class="fa-solid fa-user-plus text-gold"></i> Créer un Compte Utilisateur</div>
            <button onclick="closeModal('modalAddUtilisateur')" class="modal-close"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <form method="post" action="{{ path('app_utilisateur_nouveau') }}">
            <div class="modal-body">
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Nom *</label>
                        <input type="text" name="nom" class="form-control" placeholder="ex: KABAMBA" required>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Prénom</label>
                        <input type="text" name="prenom" class="form-control" placeholder="ex: Jean">
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Nom d'utilisateur *</label>
                        <input type="text" name="username" class="form-control" placeholder="ex: jkabamba" required>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Mot de Passe *</label>
                        <input type="password" name="password" class="form-control" placeholder="••••••••" required>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Email</label>
                        <input type="email" name="email" class="form-control" placeholder="jean@codis.cd">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Téléphone</label>
                        <input type="text" name="telephone" class="form-control" placeholder="+243 810 000 000">
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Rôle Principal</label>
                        <select name="role_id" class="form-select">
                            {% for r in rolesList %}
                                <option value="{{ r.id }}">{{ r.libelle }} ({{ r.code }})</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Pays</label>
                        <select name="pays_id" class="form-select">
                            {% for p in paysList %}
                                <option value="{{ p.id }}">{{ p.nom }} ({{ p.devise }})</option>
                            {% endfor %}
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" onclick="closeModal('modalAddUtilisateur')" class="btn btn-outline">Annuler</button>
                <button type="submit" class="btn btn-gold"><i class="fa-solid fa-plus"></i> Créer Utilisateur</button>
            </div>
        </form>
    </div>
</div>
{% endblock %}
